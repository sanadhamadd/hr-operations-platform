# Copy to .env.local and fill in the values printed by `npm run supabase:status`.
# Never commit real values. .env.local is ignored by Git.

# Read by the server at request time. Neither value is sent to the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Used only by the provisioning command (`npm run auth:provision`). The application never reads it.
SUPABASE_SECRET_KEY=
